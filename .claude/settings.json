{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.context/bin/ctx\" brief --hook",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.context/bin/ctx\" brief --hook --short",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.context/bin/ctx\" check --soft",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "env": {
    "CTX_AGENT": "claude"
  }
}
