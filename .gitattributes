# Shell scripts must keep LF even on Windows checkouts with core.autocrlf=true.
* text=auto
*.sh text eol=lf
install.sh text eol=lf
template/.context/bin/ctx text eol=lf
template/.context/bin/*.sh text eol=lf
template/.context/bin/cmd/* text eol=lf
template/.githooks/* text eol=lf
tests/** text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf
